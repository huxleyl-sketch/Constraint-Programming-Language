{
  "name": "constraint-programming-language-highlighting",
  "displayName": "Constraint Programming Language",
  "description": "Syntax highlighting and editor support for this project's .csp language.",
  "version": "0.3.5",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:constraint-programming-language"
  ],
  "publisher": "local-csp",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "constraint-programming-language",
        "path": "./snippets/csp.json"
      },
      {
        "language": "constraint-programming-language",
        "path": "./snippets/standard.json"
      }
    ],
    "languages": [
      {
        "id": "constraint-programming-language",
        "aliases": [
          "Constraint Programming Language",
          "CSP"
        ],
        "extensions": [
          ".csp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "constraint-programming-language",
        "scopeName": "source.csp",
        "path": "./syntaxes/csp.tmLanguage.json"
      }
    ]
  }
}
